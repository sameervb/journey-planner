# Copy this file to secrets.toml for local use.
# On Streamlit Community Cloud: Settings → Secrets.

# ── Google Maps (optional) ────────────────────────────────────────────────────
# Enables live driving distances and accurate geocoding.
# Without this, the app uses Haversine great-circle estimates + a 50-city
# coordinate lookup table. All tabs still work.
GOOGLE_MAPS_API_KEY = ""

# ── Ollama (optional) ─────────────────────────────────────────────────────────
# Enables the AI Advisor and Packing List tabs.
# Local instance:       http://localhost:11434
# Cloudflare Tunnel:    https://your-tunnel.trycloudflare.com
OLLAMA_BASE_URL = "https://your-tunnel.trycloudflare.com"

# Model to use (must be pulled in Ollama).
# Recommended: phi3:mini (fastest ~5s) · llama3.1:8b (best quality ~30s)
OLLAMA_MODEL = "llama3.1:8b"
